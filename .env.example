# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=gemini           # openai or gemini

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini (LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order if the primary model is temporarily unavailable (503 etc.) or retired (404).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Attempts per model for transient errors (429/500/502/503/504); backoff 2s, 4s, 8s...
GEMINI_MAX_RETRIES=3

LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
